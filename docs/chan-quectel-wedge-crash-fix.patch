+        /* capture-next: cpvt_change_state(RELEASED) below frees+unlinks cpvt (via cpvt_free), so a
+         * plain AST_LIST_TRAVERSE advancing through cpvt->entry.next would read freed memory — a
+         * use-after-free that reaches at_hangup_immediately with a garbage cpvt on the next
+         * iteration (the confirmed SIGSEGV on `quectel restart` of a wedged device). */
+        for (cpvt = AST_LIST_FIRST(&pvt->chans); cpvt; cpvt = next) {
+            next = AST_LIST_NEXT(cpvt, entry);
             at_hangup_immediately(cpvt, AST_CAUSE_NORMAL_UNSPECIFIED);
             CPVT_RESET_FLAG(cpvt, CALL_FLAG_NEED_HANGUP);
             cpvt_change_state(cpvt, CALL_STATE_RELEASED, AST_CAUSE_NORMAL_UNSPECIFIED);
