diff --git a/src/at_response.c b/src/at_response.c
index 71c488c..dfe5b62 100644
--- a/src/at_response.c
+++ b/src/at_response.c
@@ -1124,6 +1124,8 @@ static const char* next_line(const char* const str)
     return NULL;
 }
 
+#define CLCC_REAP_MISSES 2u /*!< release a call absent from this many consecutive CLCC sweeps */
+
 /*!
  * \brief Handle +CLCC response
  * \param pvt -- pvt structure
@@ -1170,6 +1172,32 @@ static int at_response_clcc(struct pvt* const pvt, const struct ast_str* const r
         handle_clcc(pvt, call_idx, dir, state, mode, mpty ? TRIBOOL_TRUE : TRIBOOL_FALSE, number, type);
     }
 
+    /* Reconcile: release any call the modem no longer lists. A lost call-end URC (^DSCI/ccinfo)
+     * otherwise strands a cpvt in DIALING forever -> device stuck, later calls fail cause 44.
+     * RoEdAl set/reset CALL_FLAG_ALIVE but never read it; this restores the reconciliation.
+     * capture-next: cpvt_change_state(RELEASED) frees+unlinks cpvt, so a plain traverse here would
+     * be use-after-free. Guarded so a just-dialed call not yet reflected in CLCC is not killed:
+     * skip INIT, and require CLCC_REAP_MISSES consecutive misses. */
+    {
+        struct cpvt* rnext;
+        for (cpvt = AST_LIST_FIRST(&pvt->chans); cpvt; cpvt = rnext) {
+            rnext = AST_LIST_NEXT(cpvt, entry);
+            if (CPVT_TEST_FLAG(cpvt, CALL_FLAG_ALIVE)) {
+                cpvt->clcc_miss = 0;
+                continue;
+            }
+            if (cpvt->state == CALL_STATE_INIT) {
+                continue; /* not yet dialed to the modem; would not be in CLCC */
+            }
+            if (++cpvt->clcc_miss < CLCC_REAP_MISSES) {
+                continue; /* grace: spare a call that may reappear on the next sweep */
+            }
+            ast_log(LOG_WARNING, "[%s] CLCC reap: releasing stranded call idx:%d state:%s (missed %u CLCC sweeps)\n", PVT_ID(pvt),
+                    cpvt->call_idx, call_state2str(cpvt->state), cpvt->clcc_miss);
+            cpvt_change_state(cpvt, CALL_STATE_RELEASED, AST_CAUSE_NORMAL_UNSPECIFIED);
+        }
+    }
+
     return 0;
 }
 
