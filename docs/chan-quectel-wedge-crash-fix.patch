diff --git a/src/at_command.c b/src/at_command.c
index c20a8b3..8b6f763 100644
--- a/src/at_command.c
+++ b/src/at_command.c
@@ -964,6 +964,27 @@ static void at_enqueue_ping_sys_chan(struct pvt* pvt) { at_enqueue_ping(&pvt->sy
 
 int at_enqueue_ping_taskproc(void* tpdata) { return PVT_TASKPROC_TRYLOCK_AND_EXECUTE(tpdata, at_enqueue_ping_sys_chan); }
 
+#define CLCC_POLL_INTERVAL_MS 5000 /*!< while a call is up, poll CLCC this often so a strand gets reaped */
+
+/* Idle maintenance run on the monitor thread's idle path. While any call is up, periodically poll
+ * CLCC so at_response_clcc can reap a call the modem dropped without a call-end URC (the wedge);
+ * otherwise keep the link alive with the normal ping. Enqueued via at_queue, so it serialises behind
+ * any in-flight AT+CMGS and can never interleave its prompt/PDU. */
+static void at_enqueue_idle_sys_chan(struct pvt* pvt)
+{
+    if (!PVT_NO_CHANS(pvt)) {
+        const struct timeval now = ast_tvnow();
+        if (ast_tvdiff_ms(now, pvt->last_clcc_poll) >= CLCC_POLL_INTERVAL_MS) {
+            pvt->last_clcc_poll = now;
+            at_enqueue_clcc(&pvt->sys_chan);
+            return;
+        }
+    }
+    at_enqueue_ping(&pvt->sys_chan);
+}
+
+int at_enqueue_idle_taskproc(void* tpdata) { return PVT_TASKPROC_TRYLOCK_AND_EXECUTE(tpdata, at_enqueue_idle_sys_chan); }
+
 /*!
  * \brief Enqueue user-specified command
  * \param cpvt -- cpvt structure
@@ -1385,7 +1406,16 @@ int at_hangup_immediately(struct cpvt* cpvt, int release_cause)
     DECLARE_NAKED_AT_CMD(chup, "+CHUP");
     DECLARE_NAKED_AT_CMDNT(qhup, "+QHUP=%d,%d");
 
-    struct pvt* const pvt = cpvt->pvt;
+    /* Defensive: never dereference a NULL/torn-down call object. The confirmed restart SIGSEGV was
+     * a use-after-free of a freed cpvt reaching here (fixed at source in pvt_disconnect); this guard
+     * catches a genuinely NULL cpvt/pvt and logs loudly rather than crashing. It does NOT catch a
+     * non-NULL dangling pointer, so it is a net, not the fix. */
+    struct pvt* const pvt = cpvt ? cpvt->pvt : NULL;
+
+    if (!pvt) {
+        ast_log(LOG_ERROR, "[chan_quectel] at_hangup_immediately: NULL cpvt/pvt — call-list corruption avoided\n");
+        return -1;
+    }
 
     if (pvt->is_simcom) {  // AT+CHUP
         static const at_queue_cmd_t cmd = ATQ_CMD_DECLARE_ST(CMD_AT_CHUP, chup);
