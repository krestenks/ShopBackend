# Environment variables required by ShopBackend (DO NOT put real values in git)
#
# On the servers: configure these as environment variables (edge box: /home/phone/shopbackend/backend.env;
# control plane: /etc/control-plane/control-plane.env).
# For local development: copy this file to `.env` and fill values, but keep `.env` uncommitted.

# CallApp RapidAPI — set to enable background phone-name screening of customers
# Get your key at https://rapidapi.com/callapp/api/callapp
CALLAPP_RAPIDAPI_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Public base URL used to build webhook URLs (e.g. the edge box's tailnet MagicDNS host,
# http://edge-1.ts.warpfactor.dk:8080). If unset, it is derived from X-Forwarded-* headers.
# NOTE: this is customer-facing (booking-link SMS) — keep it PUBLICLY reachable.
PUBLIC_BASE_URL=

# App-facing base URL the phone uses to reach THIS edge after joining the tailnet — set to the
# edge's TAILNET IP (e.g. http://100.64.0.4:8080). Used for the onboarding api= and OTA apkUrl so
# the app never depends on resolving a *.ts.warpfactor.dk hostname (MagicDNS is flaky and the public
# wildcard for that domain is a dead IP). Distinct from PUBLIC_BASE_URL. Unset = old hostname behaviour.
APP_BASE_URL=

# JWT signing secret (must be set in production)
JWT_SECRET=

# SIP reachability alerts (SipReachabilityMonitor): text managers when a shop has an on-duty
# manager but no reachable phone line. Set SIP_MONITOR_ENABLED=false to disable.
# The admin alert number is configured in the Web admin (Telephony setup), not here.

# Web admin login credentials (optional override).
# If set, ADMIN_PASSWORD is compared directly (plain text env var).
# If not set, the hardcoded fallback is: admin / 1234
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
